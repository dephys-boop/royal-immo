# GEMINI_API_KEY: Required for Gemini AI API calls if needed server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CLIENT (Frontend public anon credentials - safe for Vite client bundle)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# SUPABASE EDGE FUNCTIONS / SERVER SECRETS (NEVER prefix with VITE_ or expose to frontend)
# Configure these inside Supabase Vault / Edge Function Secrets:
# SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
# PAYMENT_WEBHOOK_SECRET="YOUR_PAYMENT_AGGREGATOR_WEBHOOK_SECRET"
# CINETPAY_API_KEY=""
# WAVE_WEBHOOK_SECRET=""
